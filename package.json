{
  "name": "ng-dependency-graph",
  "version": "0.4.0",
  "private": true,
  "description": "Chrome DevTools extension that visualises the module and component dependency graph of an AngularJS app",
  "author": {
    "name": "Filip Sobczak",
    "email": "filsob@gmail.com",
    "url": "https://filso.dev/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/filso/ng-dependency-graph.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "npx -y http-server app -p 8123 -c-1",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "rm -f ng-dependency-graph.zip && zip -qr ng-dependency-graph.zip manifest.json LICENSE app && echo 'Created ng-dependency-graph.zip'"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.0.0",
    "vitest": "^2.0.0"
  }
}
